# Non-secret settings. Copy to .env for local development.
# Dhan credentials NEVER go here - they live only in the secrets file.
BRIDGE_MODE=replay
UNIVERSE_FILE=universe/nifty50.txt
PAPER_CAPITAL=1000000
SECRETS_FILE=./secrets/dhan.env
# DATABASE_URL lives in this file, never in .env (see README "Database")
DB_SECRETS_FILE=./secrets/db.env
# local dev postgres; the production default is "require"
DB_SSLMODE=disable
HEARTBEAT_ENABLED=false
ADMIN_KEY_FILE=./secrets/admin.key
