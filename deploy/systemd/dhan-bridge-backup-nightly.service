# Install:
#   cp deploy/systemd/dhan-bridge-backup-nightly.* /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now dhan-bridge-backup-nightly.timer
# (Jenkins keeps /opt/dhan_bridge/{backup-nightly.sh,ops.sh} up to date.)
[Unit]
Description=dhan_bridge nightly database backup: dump, verify, off-host copy, prune
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=APP_DIR=/opt/dhan_bridge
ExecStart=/opt/dhan_bridge/backup-nightly.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1h
