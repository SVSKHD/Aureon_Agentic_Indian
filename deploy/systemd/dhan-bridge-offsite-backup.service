# Install: cp deploy/systemd/dhan-bridge-offsite-backup.* /etc/systemd/system/
#          cp deploy/backup-offsite.sh /opt/dhan_bridge/ && chmod 750 /opt/dhan_bridge/backup-offsite.sh
#          systemctl daemon-reload && systemctl enable --now dhan-bridge-offsite-backup.timer
[Unit]
Description=Copy the newest dhan_bridge SQLite backup off-host
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/dhan_bridge/offsite.env
ExecStart=/opt/dhan_bridge/backup-offsite.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
